# Local database backups / dumps — keep these out of version control
/backups/

# Async mail spool — queued emails can contain temp passwords
/storage/mail_spool/

# Claude Code local session state
/.claude/

# Local UI capture run (large PNGs, not useful in history)
screenshots/

# ------------------------------------------------------------------
# User-uploaded content — REAL PEOPLE'S PERSONAL DATA. Never commit.
# Merchant applicants upload business permits, sanitary permits and
# barangay clearances; finance uploads fee-waiver evidence; students,
# parents and merchants upload photos and logos. All of it is written
# at runtime and every one of these directories is recreated by the
# app with mkdir(..., recursive), so nothing here needs to be in git.
#
# uploads/.htaccess is the exception and stays tracked — it is the
# "Deny from all" rule that keeps these files from being served
# directly, and the app will not recreate it.
# ------------------------------------------------------------------
/uploads/*
!/uploads/.htaccess
/assets/profile_photos/
/assets/merchant_logos/

# Database dumps. Migration scripts in /database/ are tracked; a dump
# of live data is not — it contains every user row.
/database/ewallet_*.sql
*.dump.sql

# Audit-trail database credentials. connection/audit_config.example.php is the
# tracked template; the real file holds the gjc_audit_writer password and is
# written by database/migrations/audit_hardening.php at install time.
/connection/audit_config.php

# Gmail SMTP credentials. connection/mail_config.example.php is the tracked
# template; the real file holds the Google App Password.
/connection/mail_config.php

# Application database login + view-token signing key. connection/local_config.example.php
# is the tracked template; the real file holds the live root password.
/connection/local_config.php
